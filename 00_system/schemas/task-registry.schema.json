{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paos://schemas/task-registry/0.3",
  "type": "object",
  "required": ["schema_version", "artifact_state", "allowed_statuses", "tasks"],
  "properties": {
    "schema_version": {"type": "string"},
    "artifact_state": {"type": "string", "enum": ["WORKING", "APPROVED", "ARCHIVED"]},
    "allowed_statuses": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "status",
          "platform",
          "platform_ref"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^paos-[0-9]{2}-[a-z0-9-]+$"},
          "purpose": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["TODO", "ACTIVE", "BLOCKED", "REVIEW", "DONE"]},
          "validation": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "platform": {"type": "string"},
          "platform_ref": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

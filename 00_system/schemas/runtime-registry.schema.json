{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paos://schemas/runtime-registry/0.2",
  "type": "object",
  "required": ["schema_version", "artifact_state", "runtimes"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-working$"},
    "artifact_state": {"type": "string", "enum": ["WORKING", "APPROVED", "ARCHIVED"]},
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "platform", "availability", "version", "verified_on", "project_config", "runtime_smoke"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "platform": {"type": "string", "enum": ["codex", "claude-code", "antigravity-cli"]},
          "availability": {"type": "string", "enum": ["INSTALLED", "TRANSIENT_AVAILABLE", "NOT_INSTALLED"]},
          "version": {"type": "string", "minLength": 1},
          "verified_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "project_config": {"type": "string", "minLength": 1},
          "config_load": {"type": "string", "enum": ["PASS", "NOT_RUN", "BLOCKED"]},
          "runtime_smoke": {"type": "string", "enum": ["PASS", "NOT_RUN", "BLOCKED"]},
          "smoke_evidence": {"type": "string"},
          "config_evidence": {"type": "string"},
          "blocked_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "issues": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paos://schemas/skill-registry/0.2",
  "type": "object",
  "required": ["schema_version", "artifact_state", "skills"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-working$"},
    "artifact_state": {"type": "string", "enum": ["WORKING", "APPROVED", "ARCHIVED"]},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "artifact_state", "owner", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "path": {"type": "string", "minLength": 1},
          "artifact_state": {"type": "string", "enum": ["WORKING", "APPROVED", "ARCHIVED"]},
          "owner": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

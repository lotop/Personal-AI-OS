# 依赖清单使用语言原生文件（pyproject.toml / package.json / go.mod），不在此重复。
[stack]
language = ""
language_version = ""
package_manager = ""
source_dir = ""
test_command = ""
lint_command = ""
build_command = ""
run_command = ""

schema_version = "0.3.0-working"
project_id = "{{PROJECT_ID}}"
name = "{{PROJECT_NAME}}"
owner = "{{OWNER}}"
status = "PROVISIONAL"
primary_type = "{{PRIMARY_TYPE}}"
template_pack = "paos-project-base"
template_version = "{{TEMPLATE_VERSION}}"

[paths]
governance = "00_governance"
sources = "01_sources"
knowledge = "02_knowledge"
